<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
            <Button>Hermes</Button>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Label">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Default button hover / press -->
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <!-- NumericUpDown / TextBox styling -->
    <Style Selector="NumericUpDown, TextBox">
        <Setter Property="Padding" Value="8, 10" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="ShowButtonSpinner" Value="False" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBox.Telemetry">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TelemetryTextBoxForegroundBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{DynamicResource TelemetryTextBoxBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TelemetryTextBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.Telemetry /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource TelemetryTextBoxBackgroundBrush}" />
    </Style>

    <!-- TableView -->
    <Style Selector="TableView">
        <Setter Property="BorderBrush" Value="{DynamicResource TableBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DefaultCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource TableRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TableRowForegroundBrush}" />
    </Style>
    <Style Selector="TableViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TableHeaderForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TableViewRow">
        <Setter Property="Background" Value="{DynamicResource TableRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TableRowForegroundBrush}" />
    </Style>
    <Style Selector="TableViewRow:selected">
        <Setter Property="Background" Value="{DynamicResource TableRowSelectedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TableRowSelectedForegroundBrush}" />
    </Style>
    <Style Selector="TableViewRow:selected /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TableRowSelectedForegroundBrush}" />
    </Style>
</Styles>