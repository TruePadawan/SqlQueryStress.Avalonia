<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SqlQueryStress.ViewModels"
        xmlns:models="using:SqlQueryStress.Models"
        x:DataType="vm:DatabaseSelectViewModel"
        mc:Ignorable="d"
        x:Class="SqlQueryStress.Views.DatabaseSelectWindow"
        Title="Database Select"
        SizeToContent="Height"
        MaxWidth="800"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Name="OkButton" Content="OK" Width="80" Click="OkButton_OnClick" />
            <Button Name="CancelButton" Content="Cancel" Width="80" Click="CancelButton_OnClick" />
        </StackPanel>

        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
            <!-- Main Load Settings -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Main Load Settings" FontWeight="SemiBold" />

                <Border Margin="0, 8, 0, 0"
                        Padding="10"
                        BorderBrush="{DynamicResource SeparatorBackgroundBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8" MinWidth="250">
                        <StackPanel Spacing="4">
                            <Label Content="Server" FontWeight="SemiBold" />
                            <TextBox Name="MainServerTextBox"
                                     Text="{Binding MainServer}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Label Content="Authentication" FontWeight="SemiBold" />
                            <ComboBox Name="MainAuthenticationComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding SelectedMainDbAuthenticationMode}"
                                      ItemsSource="{Binding AuthenticationModeOptions}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AuthenticationModeOption">
                                        <TextBlock
                                            Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Label Content="Login" />
                            <TextBox Name="MainLoginTextBox" Text="{Binding MainLogin}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Label Content="Password" />
                            <TextBox Name="MainPasswordTextBox" PasswordChar="●"
                                     Text="{Binding MainPassword}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <DockPanel>
                                <CheckBox Name="MainAutoRefreshCheckBox"
                                          DockPanel.Dock="Right"
                                          Content="auto-refresh"
                                          IsChecked="True" />
                                <Label Content="Default Database" FontWeight="SemiBold" />
                            </DockPanel>
                            <ComboBox Name="MainDefaultDatabaseComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <CheckBox Name="MainApplicationIntentCheckBox" Content="Application Intent"
                                  IsChecked="{Binding MainApplicationIntentEnabled}" />

                        <ComboBox Name="MainApplicationIntentComboBox" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ApplicationIntentOptions}"
                                  SelectedItem="{Binding MainApplicationIntent}"
                                  IsEnabled="{Binding MainApplicationIntentEnabled}" />

                        <StackPanel Spacing="4">
                            <Label Content="Encrypt" FontWeight="SemiBold" />
                            <ComboBox Name="MainEncryptComboBox" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding EncryptOptions}"
                                      SelectedItem="{Binding MainEncryptOption}" />
                        </StackPanel>

                        <CheckBox Name="MainTrustServerCertificateCheckBox"
                                  Content="Trust Server Certificate"
                                  IsChecked="{Binding MainTrustServerCertificate}" />

                        <StackPanel Spacing="4">
                            <Label Content="Additional Parameters" FontWeight="SemiBold" />
                            <TextBox Name="MainAdditionalParametersTextBox"
                                     AcceptsReturn="True"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     Text="{Binding MainAdditionalParameters}" />
                        </StackPanel>

                        <Button Name="MainTestConnectionButton"
                                Content="Test Connection"
                                HorizontalAlignment="Right"
                                Click="MainTestConnectionButton_OnClick" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Parameterization Settings -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Parameterization Settings:" FontWeight="SemiBold" />

                <Border Margin="0, 8, 0, 0"
                        Padding="10"
                        BorderBrush="{DynamicResource SeparatorBackgroundBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8" MinWidth="250">
                        <CheckBox Name="ShareConnectionSettingsCheckBox"
                                  Content="Share Connection Settings"
                                  IsChecked="{Binding ShareDbSettings}"
                                  FontWeight="SemiBold" />

                        <StackPanel Spacing="4" IsEnabled="{Binding !ShareDbSettings}">
                            <Label Content="Server" FontWeight="SemiBold" />
                            <TextBox Name="ParamServerTextBox"
                                     Text="{Binding ParamServer}" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsEnabled="{Binding !ShareDbSettings}">
                            <Label Content="Authentication" FontWeight="SemiBold" />
                            <ComboBox Name="ParamAuthenticationComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding SelectedParamDbAuthenticationMode}"
                                      ItemsSource="{Binding AuthenticationModeOptions}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AuthenticationModeOption">
                                        <TextBlock
                                            Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4" IsEnabled="{Binding !ShareDbSettings}">
                            <Label Content="Login" />
                            <TextBox Name="ParamLoginTextBox"
                                     Text="{Binding ParamLogin}" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsEnabled="{Binding !ShareDbSettings}">
                            <Label Content="Password" />
                            <TextBox Name="ParamPasswordTextBox" PasswordChar="●"
                                     Text="{Binding ParamPassword}" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsEnabled="{Binding !ShareDbSettings}">
                            <Label Content="Default Database" FontWeight="SemiBold" />
                            <ComboBox Name="ParamDefaultDatabaseComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <CheckBox Name="ParamApplicationIntentCheckBox" Content="Application Intent"
                                  IsChecked="{Binding ParamApplicationIntentEnabled}"
                                  IsEnabled="{Binding !ShareDbSettings}" />
                        <ComboBox Name="ParamApplicationIntentComboBox" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ApplicationIntentOptions}"
                                  SelectedItem="{Binding ParamApplicationIntent}"
                                  IsEnabled="{Binding ParamApplicationIntentEnabled}" />

                        <StackPanel Spacing="4" IsEnabled="{Binding !ShareDbSettings}">
                            <Label Content="Encrypt" FontWeight="SemiBold" />
                            <ComboBox Name="ParamEncryptComboBox" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding EncryptOptions}"
                                      SelectedItem="{Binding ParamEncryptOption}" />
                        </StackPanel>

                        <CheckBox Name="ParamTrustServerCertificateCheckBox"
                                  Content="Trust Server Certificate"
                                  IsChecked="{Binding ParamTrustServerCertificate}"
                                  IsEnabled="{Binding !ShareDbSettings}" />

                        <StackPanel Spacing="4" IsEnabled="{Binding !ShareDbSettings}">
                            <Label Content="Additional Parameters" FontWeight="SemiBold" />
                            <TextBox Name="ParamAdditionalParametersTextBox"
                                     AcceptsReturn="True"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     Text="{Binding ParamAdditionalParameters}" />
                        </StackPanel>

                        <Button Name="ParamTestConnectionButton"
                                Content="Test Connection"
                                HorizontalAlignment="Right"
                                Click="ParamTestConnectionButton_OnClick"
                                IsEnabled="{Binding !ShareDbSettings}" />
                    </StackPanel>
                </Border>
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>